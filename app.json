{
  "expo": {
    "name": "Namaz Rehberim",
    "slug": "namaz-rehberim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "namazrehberim",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emrecanunlu.namazrehberim",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-ios-dark.png",
        "tinted": "./assets/icon-ios-tinted.png"
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "Bulunduğun ile göre namaz vakitlerini ve kıble yönünü hesaplamak için konumunu kullanırız. Konum cihazından dışarı gönderilmez.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAlarmKitUsageDescription": "Vakit alarmlarını, telefon sessizdeyken de çalan sistem alarmı olarak kurmak için kullanılır."
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.emrecanunlu.namazrehberim",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "backgroundColor": "#1a2f25",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bulunduğun ile göre namaz vakitlerini ve kıble yönünü hesaplamak için konumunu kullanırız. Konum cihazından dışarı gönderilmez.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a2f25",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0f1a15",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/alarm_tone.wav",
            "./assets/sounds/adhan_short.wav",
            "./assets/sounds/reminder_sparkle.wav",
            "./assets/sounds/reminder_chime.wav"
          ],
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#b8892e"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92adad1f-674f-4fcf-abb7-bdcfefc2f5be"
      }
    },
    "owner": "emreunlu0",
    "description": "Adım adım namaz rehberi, il bazlı namaz vakitleri, kıble ve günlük dua.",
    "primaryColor": "#1a2f25",
    "backgroundColor": "#1a2f25",
    "locales": {
      "tr": "./locales/native/tr.json",
      "en": "./locales/native/en.json"
    }
  }
}
