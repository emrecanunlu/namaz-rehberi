{
  "expo": {
    "name": "Namaz Rehberim",
    "slug": "namaz-rehberim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "namazrehberim",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emrecanunlu.namazrehberim",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Namaz vakitleri ve kıble yönü için konumunuza ihtiyaç duyuyoruz.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "package": "com.emrecanunlu.namazrehberim",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1a2f25",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },

    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-font",

      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Namaz vakitleri ve kıble yönü için konumunuza ihtiyaç duyuyoruz."
        }
      ],

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a2f25",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],

      "expo-audio",
      "expo-asset",
      "expo-sharing",
      "expo-status-bar"
    ],

    "extra": {
      "router": {},
      "eas": {
        "projectId": "92adad1f-674f-4fcf-abb7-bdcfefc2f5be"
      }
    },

    "owner": "emreunlu0"
  }
}
